# 服务配置
NODE_ENV=production
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=node_lean
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# JWT 配置
JWT_SECRET=change-this-to-a-very-strong-random-secret-key
JWT_EXPIRES_IN=24h

# 日志配置
LOG_LEVEL=info
LOG_DIR=logs

# 文件上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
